{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aegisrt:experiment:event:v1",
  "title": "AegisRT allowlisted experiment event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "sequence",
    "event_type",
    "status",
    "phase",
    "recorded_at",
    "monotonic_ns",
    "experiment_kind",
    "case_id",
    "pair_id",
    "seed",
    "repetition",
    "trial_order",
    "treatment",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "aegisrt.experiment.event/v1"
    },
    "run_id": {
      "$ref": "#/$defs/opaque_id"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "event_type": {
      "enum": [
        "plan.declared",
        "run.started",
        "trial.started",
        "metric.sample",
        "fault.injected",
        "fault.detected",
        "recovery.started",
        "recovery.completed",
        "trial.completed",
        "artifact.recorded",
        "run.completed",
        "run.failed"
      ]
    },
    "status": {
      "enum": ["NOT_EXECUTED", "RUNNING", "SUCCEEDED", "FAILED", "SKIPPED", "TIMED_OUT", "INVALID"]
    },
    "phase": {
      "enum": ["planned", "warmup", "measurement", "cleanup"]
    },
    "recorded_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "monotonic_ns": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "experiment_kind": {
      "enum": ["scheduler", "context", "fault", "fault-kernel", "resource"]
    },
    "case_id": {
      "$ref": "#/$defs/nullable_label"
    },
    "pair_id": {
      "$ref": "#/$defs/nullable_label"
    },
    "seed": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 4294967295
    },
    "repetition": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "trial_order": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "treatment": {
      "$ref": "#/$defs/nullable_label"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason_code": {
          "enum": [
            "NONE",
            "HARNESS_FAILURE",
            "TIMEOUT",
            "AGENT_EXIT",
            "DAEMON_EXIT",
            "CHECKPOINT_REJECTED",
            "CGROUP_CLEANUP_FAILED",
            "PROTOCOL_VIOLATION"
          ]
        },
        "metric": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "value", "unit"],
          "properties": {
            "name": {"$ref": "#/$defs/safe_label"},
            "value": {"type": "number"},
            "unit": {
              "enum": ["count", "ratio", "bytes", "tokens", "milliseconds", "nanoseconds", "tasks_per_second", "percent"]
            }
          }
        },
        "fault": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "boundary", "target", "expected_recovery", "outcome"],
          "properties": {
            "mode": {
              "enum": ["none", "agent_exit", "agent_timeout", "daemon_sigkill", "orphan_attempt_cgroup", "checkpoint_corruption"]
            },
            "boundary": {
              "enum": ["before_dispatch", "during_execution", "after_context_publish", "before_completion_persist", "on_restart"]
            },
            "target": {
              "enum": ["agent", "daemon", "state_file", "cgroup"]
            },
            "expected_recovery": {
              "enum": ["none", "requeue", "terminal_failure", "fail_closed"]
            },
            "outcome": {
              "enum": ["not_observed", "detected", "recovered", "contained", "failed_closed", "escaped"]
            }
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "bytes"],
          "properties": {
            "path": {"$ref": "#/$defs/relative_path"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "bytes": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  },
  "$defs": {
    "opaque_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "safe_label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "nullable_label": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/safe_label"}
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)[.][.](?:/|$))(?!/)(?![A-Za-z]:)[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "NOT_EXECUTED"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "event_type": {"const": "plan.declared"},
          "phase": {"const": "planned"},
          "recorded_at": {"type": "null"},
          "monotonic_ns": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "recorded_at": {"type": "string", "format": "date-time"},
          "monotonic_ns": {"type": "integer", "minimum": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"event_type": {"const": "metric.sample"}},
        "required": ["event_type"]
      },
      "then": {"properties": {"payload": {"required": ["metric"]}}}
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": ["fault.injected", "fault.detected", "recovery.started", "recovery.completed"]
          }
        },
        "required": ["event_type"]
      },
      "then": {"properties": {"payload": {"required": ["fault"]}}}
    },
    {
      "if": {
        "properties": {"event_type": {"const": "artifact.recorded"}},
        "required": ["event_type"]
      },
      "then": {"properties": {"payload": {"required": ["artifact"]}}}
    }
  ]
}
